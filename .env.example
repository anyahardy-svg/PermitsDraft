# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com -> Project Settings -> API
# Copy from .env (do not edit this file)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required for scripts/upload-email-logos.js (service role key from Supabase -> Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Email Service
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Scheduled reminder emails (Vercel Cron) — shared cap for accreditation + induction
# Generate a long random string for manual dry-run triggers; Vercel Cron also sends x-vercel-cron: 1
CRON_SECRET=your-cron-secret-here
# Max reminder emails per day across all reminder types (default 150)
REMINDER_BATCH_SIZE=150
# Days between reminder emails per company (default 30 = once a month)
REMINDER_INTERVAL_DAYS=30
